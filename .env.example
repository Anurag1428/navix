# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Liveblocks
LIVEBLOCKS_SECRET_KEY=sk_...

# Trigger.dev
TRIGGER_SECRET_KEY=tr_dev_...

# Browserbase & Stagehand
BROWSERBASE_API_KEY=bb_...
BROWSERBASE_PROJECT_ID=...
USE_LOCAL_BROWSER=false
STAGEHAND_MODEL=google/gemini-flash-lite-latest

# AI Model Keys
GEMINI_API_KEY=...
GROQ_API_KEY=...

# Resend Email
RESEND_API_KEY=re_...

# ── Airtable Job Application Tracking ──────────────────────────────────────
# Personal Access Token generated at https://airtable.com/create/tokens
# Required scopes: data.records:read, data.records:write, schema.bases:read
AIRTABLE_PERSONAL_ACCESS_TOKEN=pat...

# Airtable Base ID (starts with 'app...', visible in the base URL)
AIRTABLE_BASE_ID=app...

# Airtable Table Name (defaults to 'Job Applications')
AIRTABLE_TABLE_NAME=Job Applications

# ── Airtable Outbound Pitches (Funded Startup Outreach) ──────────────────────
# Optional: defaults to AIRTABLE_BASE_ID if omitted
AIRTABLE_OUTBOUND_BASE_ID=app...
# Optional: defaults to 'Outbound Pitches' if omitted
AIRTABLE_OUTBOUND_TABLE_NAME=Outbound Pitches

# ── Telegram Notifications & Remote Control Bot ─────────────────────────────
# 1. Message @BotFather on Telegram -> /newbot -> get your Bot Token
# 2. Start your bot, then message @userinfobot to get your numeric Chat ID
TELEGRAM_BOT_TOKEN=7967088623:AAH...
TELEGRAM_CHAT_ID=123456789

# Telegram Remote Control Bot (trigger workflows on the go from your phone):
# NAVIX_ORG_ID: Your Clerk organization ID
NAVIX_ORG_ID=org_...
# TELEGRAM_WEBHOOK_SECRET: Secret token to ensure only Telegram can POST to webhook
TELEGRAM_WEBHOOK_SECRET=your_random_secret_here
# TELEGRAM_SETUP_SECRET: Protects GET /api/telegram/setup endpoint
TELEGRAM_SETUP_SECRET=another_random_secret_here
# Your public deployed URL or tunnel URL (e.g. ngrok/Cloudflare tunnel)
NEXT_PUBLIC_APP_URL=https://your-navix-domain.com

# ── WhatsApp Notifications ──────────────────────────────────────────────────
# Option A: Twilio WhatsApp (Standard developer API)
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
WHATSAPP_TO_NUMBER=whatsapp:+1234567890

# Option B: CallMeBot WhatsApp (Free personal alerts)
# CALLMEBOT_PHONE=+1234567890
# CALLMEBOT_API_KEY=...
